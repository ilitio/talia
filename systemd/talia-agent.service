[Unit]
Description=Talia host monitoring agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=talia
Group=talia
EnvironmentFile=-/etc/talia/talia-agent.env
ExecStart=/usr/local/bin/talia-agent --config /etc/talia/talia-agent.toml
Restart=always
RestartSec=5s
StateDirectory=talia
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/talia
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
